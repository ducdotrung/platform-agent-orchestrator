# Safe public-sample defaults. Demo mode requires no database or credentials;
# the Compose local profile reads generated secrets from mounted files.
PLATFORM_PROFILE=demo
PLATFORM_RUNTIME_ROLE=cli
PLATFORM_ADAPTER_MODE=demo
PLATFORM_BIND_HOST=127.0.0.1
PLATFORM_BIND_PORT=8080
PLATFORM_SCOPE_ID=sock-shop-sample
PLATFORM_ALLOWED_SOURCES=sample-sre-alert-agent
PLATFORM_ALLOWED_REVIEWERS=sample-reviewer
PLATFORM_ALLOWED_SERVICES=carts,catalogue,front-end,orders,payment,shipping,user
PLATFORM_MAX_REQUEST_BYTES=65536
PLATFORM_EXTERNAL_EGRESS_ENABLED=false
ORCHESTRATOR_DATABASE_URL=
CHECKPOINT_DATABASE_URL=
PLATFORM_WEBHOOK_SIGNING_SECRET=
PLATFORM_REVIEWER_SIGNING_SECRET=
PLATFORM_WEBHOOK_MAX_SKEW_SECONDS=300
PLATFORM_WEBHOOK_NONCE_TTL_SECONDS=1200

# Optional: only needed when replacing deterministic demo agents.
MODEL_NAME=openai:gpt-5-mini

# Production adapters should load their own credentials from secret storage.
# Never put tokens into DomainEvent payloads or LangGraph checkpoint state.

# Optional Langfuse tracing. The default no-op backend needs no extra package.
PLATFORM_OBSERVABILITY=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set this for a self-hosted Langfuse deployment.
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1.0

# Payloads, prompts, tool arguments, and outputs are dropped by default.
# Enable only after reviewing data classification and retention requirements.
PLATFORM_TRACE_CAPTURE_CONTENT=false
